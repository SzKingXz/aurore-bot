{
  "name": "aurore-bot",
  "version": "4.0.0",
  "description": "AURORE Discord Bot",
  "main": "bot.js",
  "author": "",
  "license": "MIT",
  "engines": { "node": "20.x" },
  "scripts": {
    "start":     "node bot.js",
    "dev":       "node bot.js",
    "test":      "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:int":  "jest tests/integration --runInBand --forceExit",
    "test:cov":  "jest --coverage --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["security.js","cache.js","db.js","api.js"],
    "coverageReporters": ["text","text-summary","lcov"],
    "testTimeout": 15000
  },
  "dependencies": {
    "discord.js":     "^14.14.1",
    "express":        "^4.18.2",
    "cors":           "^2.8.5",
    "dotenv":         "^16.4.5",
    "ws":             "^8.17.1",
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "jest":       "^29.7.0",
    "supertest":  "^7.0.0",
    "autocannon": "^7.15.0"
  }
}
